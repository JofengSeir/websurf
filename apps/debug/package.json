{
  "name": "websurf-debug",
  "version": "0.1.0",
  "description": "浏览器中的 Counter-Strike 滑翔（Surf）地图调试台：碰撞/路径/平面检视与输入录制；BSP 解析（WASM）+ CS 移动物理 + Three.js 渲染。",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:wasm": "cd crates/wasm && wasm-pack build --release --target web --out-dir ../../../../.tmp/wasm-out/debug && node ../../../../src/scripts/copy-wasm-pkg.mjs debug",
    "typecheck": "tsc --noEmit",
    "build:worker": "esbuild src/worker/main.ts --bundle --outfile=web/worker.js --format=esm --target=es2022",
    "build:app": "esbuild src/app.ts --bundle --outfile=web/app.js --format=esm --target=es2022",
    "build:ts": "npm run typecheck && npm run build:worker && npm run build:app",
    "build:dist": "node scripts/build-dist.mjs",
    "build": "npm run build:wasm && npm run build:ts",
    "predev": "node ../../src/scripts/sync-default-textures.mjs",
    "dev": "python ../../src/serve.py 8080 .",
    "check:api": "node scripts/check-wasm-api.mjs",
    "count:glb-meshes": "node scripts/glb-mesh-count.mjs",
    "bench:frames": "node scripts/frame-bench.mjs",
    "test:optimize-scene": "esbuild src/renderer/renderer-main.ts --bundle --format=esm --platform=node --outfile=.tmp/opt-verify/renderer-main.bundle.mjs && esbuild ../../src/renderer-shared/scene/scene-optimizer.ts --bundle --format=esm --platform=node --outfile=.tmp/opt-verify/scene-optimizer.bundle.mjs && node scripts/optimize-scene-verify.mjs",
    "test:surf-crouch": "node scripts/phys-surf-crouch-smoke.mjs",
    "plot:path": "node scripts/plot-path.mjs",
    "test:auth-clock": "esbuild ../../src/ts-shared/auth/auth-loop.ts --bundle --format=esm --platform=node --outfile=.tmp/auth-clock/auth-loop.bundle.mjs && node scripts/auth-clock-verify.mjs",
    "test:jump-apex": "esbuild ../../src/ts-shared/phys/authority-calibrator.ts --bundle --format=esm --platform=node --outfile=.tmp/jump-apex/authority-calibrator.bundle.mjs && node scripts/jump-apex-verify.mjs",
    "check:param-defaults": "node scripts/check-param-defaults.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.23.0",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
