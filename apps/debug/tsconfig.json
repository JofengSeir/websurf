{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@physics/*": ["src/physics/*"],
      "@world/*": ["src/world/*"],
      "@renderer/*": ["src/renderer/*"],
      "@input/*": ["src/input/*"],
      "@worker/*": ["src/worker/*"]
    }
  },
  "include": ["src", "../../src/ts-shared/**/*.ts", "../../src/renderer-shared/**/*.ts"],
  "exclude": ["node_modules", "pkg", "crates"]
}
