{
  "name": "websurf",
  "private": true,
  "description": "WebSurf 仓库根：承载跨工程共享的 npm 依赖（src/renderer-shared 等共享层由此解析 three）与少量流程/门禁脚本。",
  "scripts": {
    "agent:brief": "node src/scripts/agent-memory.mjs brief",
    "agent:save": "node src/scripts/agent-memory.mjs save",
    "agent:handoff": "node src/scripts/agent-memory.mjs handoff",
    "agent:flush": "node src/scripts/agent-memory.mjs flush",
    "agent:audit": "node src/scripts/agent-audit.mjs",
    "check:render-parity": "node src/scripts/check-render-parity.mjs"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0"
  }
}
